# URL base del Worker de la API (Cloudflare Workers + D1) — ver webapp/worker/.
# Sustituye TU-SUBDOMINIO por el subdominio real que asigna Cloudflare al
# desplegar (`wrangler deploy` dentro de webapp/worker/), o por el dominio
# propio si se configura uno. Sin esta variable definida en tiempo de
# ejecución, la app lanza un error claro al primer intento de hablar con la
# API (ver getApiBaseUrl en src/data/sqlite/client.ts) — el build en sí no
# falla por su ausencia.
VITE_API_BASE_URL=https://wharmy-api.TU-SUBDOMINIO.workers.dev
